{
	"name": "pi-telegram-agent",
	"private": true,
	"version": "1.1.10",
	"type": "module",
	"description": "Configurable Telegram group companions powered by Pi SDK",
	"scripts": {
		"build": "node scripts/build.mjs",
		"start": "node dist/src/daemon/index.js",
		"debug": "node dist/scripts/debug-report.js",
		"test": "npm run build && TZ=UTC node --import ./dist/test/network-guard.js --test dist/test/*.test.js",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"release:package": "npm run build && node scripts/release.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-codemode": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-env": "1.5.2",
		"@earendil-works/pi-schema": "1.5.2",
		"jiti": "2.7.0",
		"marked": "18.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "24.13.3",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
