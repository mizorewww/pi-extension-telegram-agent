{
	"name": "pi-telegram-agent",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Configurable Telegram group companions powered by Pi SDK",
	"scripts": {
		"docs:build": "bun run scripts/docs-site.ts build",
		"docs:check": "bun run scripts/docs-site.ts check",
		"start": "bun run src/daemon/index.ts",
		"debug": "bun run scripts/debug-report.ts",
		"test": "bun test",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^24.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^5.9.0"
	}
}
