{
	"name": "pi-telegram-agent",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Configurable Telegram group companions with a Pi-native chat interface",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./.pi/extensions/tg-extension.ts"
		]
	},
	"scripts": {
		"pi": "bun run scripts/pi-launcher.ts",
		"docs:build": "bun run scripts/docs-site.ts build",
		"docs:check": "bun run scripts/docs-site.ts check",
		"start": "bun run src/main.ts start",
		"restart": "bun run src/main.ts restart",
		"status": "bun run src/main.ts status",
		"debug": "bun run scripts/debug-report.ts",
		"stop": "bun run src/main.ts stop",
		"test": "bun test",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.86.0",
		"@earendil-works/pi-ai": "0.86.0",
		"@earendil-works/pi-coding-agent": "0.86.0",
		"@earendil-works/pi-tui": "0.86.0",
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^24.0.0",
		"bun-types": "^1.3.14",
		"typescript": "^5.9.0"
	}
}
