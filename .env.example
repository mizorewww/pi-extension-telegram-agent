# 本项目 .env 用冒号格式 `key: value`（不是 dotenv 的 KEY=value）。
# bot 列表、persona 路径、模型参数、routing 概率在 telegram.config.ts（复制 telegram.config.example.ts）。
# .env 只放 Telegram/TinyFish/router 等项目 secret；LLM 登录与 API key 由 Pi 管理。

# Telegram bot token（key 名要与 telegram.config.ts 里的 token_env 对应）
telegram_bot_token: 123456:REPLACE_WITH_BOTFATHER_TOKEN

# Optional TinyFish search API key. Not required while every bot has tools.search: false.
tiny_fish_api_key: REPLACE_WITH_TINYFISH_KEY

# Routing secret for deterministic router (HMAC key); any random string
router_secret: REPLACE_WITH_RANDOM_LOCAL_SECRET
